<?xml version="1.0" encoding="utf-8"?>
<!--
  The control server and LiveKit run on the church LAN over ws/http.
  Cleartext is limited to this app; audio never leaves the LAN.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
